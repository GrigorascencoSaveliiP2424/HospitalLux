<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane styleClass="root"
            stylesheets="@style.css"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.example.practica.controller.MainController">

    <top>
        <VBox>
            <HBox alignment="CENTER"
                  spacing="28"
                  styleClass="top-navigation">

                <padding>
                    <Insets bottom="24" left="28" right="28" top="24"/>
                </padding>

                <Button fx:id="homeBtn" onAction="#showHome" styleClass="menu-button-active" prefWidth="250" prefHeight="78">
                    <graphic>
                        <HBox alignment="CENTER" spacing="14">
                            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                <image>
                                    <Image url="@icons/home.png"/>
                                </image>
                            </ImageView>
                            <Label styleClass="menu-button-text" text="Главная"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="patientsBtn" onAction="#showPatients" styleClass="menu-button" prefWidth="250" prefHeight="78">
                    <graphic>
                        <HBox alignment="CENTER" spacing="14">
                            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                <image>
                                    <Image url="@icons/patient.png"/>
                                </image>
                            </ImageView>
                            <Label styleClass="menu-button-text" text="Пациенты"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="wardsBtn" onAction="#showWards" styleClass="menu-button" prefWidth="250" prefHeight="78">
                    <graphic>
                        <HBox alignment="CENTER" spacing="14">
                            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                <image>
                                    <Image url="@icons/ward.png"/>
                                </image>
                            </ImageView>
                            <Label styleClass="menu-button-text" text="Палаты"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="departmentsBtn" onAction="#showDepartments" styleClass="menu-button" prefWidth="250" prefHeight="78">
                    <graphic>
                        <HBox alignment="CENTER" spacing="14">
                            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                <image>
                                    <Image url="@icons/department.png"/>
                                </image>
                            </ImageView>
                            <Label styleClass="menu-button-text" text="Отделения"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="statsBtn" onAction="#showStats" styleClass="menu-button" prefWidth="250" prefHeight="78">
                    <graphic>
                        <HBox alignment="CENTER" spacing="14">
                            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                <image>
                                    <Image url="@icons/statistics.png"/>
                                </image>
                            </ImageView>
                            <Label styleClass="menu-button-text" text="Статистика"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="reportBtn" onAction="#showReport" styleClass="menu-button" prefWidth="250" prefHeight="78">
                    <graphic>
                        <HBox alignment="CENTER" spacing="14">
                            <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                                <image>
                                    <Image url="@icons/report.png"/>
                                </image>
                            </ImageView>
                            <Label styleClass="menu-button-text" text="Отчёт"/>
                        </HBox>
                    </graphic>
                </Button>

            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane styleClass="main-content">

            <VBox fx:id="homeContent" spacing="28">
                <padding>
                    <Insets bottom="44" left="64" right="64" top="58"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="34" VBox.vgrow="ALWAYS">
                    <VBox prefWidth="520" spacing="16">
                        <Label styleClass="hero-kicker" text="МЕДИЦИНСКАЯ СИСТЕМА"/>
                        <Label styleClass="hero-title" text="HospitalLux"/>
                        <Label fx:id="pageTitle" styleClass="page-title" text="Главная"/>
                        <Label styleClass="hero-description"
                               text="Приложение помогает удобно вести учёт пациентов, палат и отделений больницы. В системе можно добавлять пациентов, редактировать данные, распределять их по свободным палатам, просматривать отделения и формировать общий отчёт."
                               wrapText="true"/>
                    </VBox>

                    <StackPane prefHeight="620" prefWidth="980" styleClass="hero-card-big" HBox.hgrow="ALWAYS">
                        <ImageView fitHeight="640" fitWidth="1050" preserveRatio="false" smooth="true">
                            <image>
                                <Image url="@icons/doctor1.png"/>
                            </image>
                            <clip>
                                <Rectangle arcHeight="38" arcWidth="38" height="640" width="1050"/>
                            </clip>
                        </ImageView>
                    </StackPane>
                </HBox>
            </VBox>

            <VBox fx:id="dataContent" managed="false" spacing="22" visible="false">
                <padding>
                    <Insets bottom="36" left="64" right="64" top="34"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="actions-panel">
                    <TextField fx:id="searchField"
                               promptText="Поиск по ФИО, адресу и диагнозу ..."
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS"/>

                    <Button fx:id="addBtn" onAction="#handleAdd" styleClass="primary-button" text="Записаться"/>
                    <Button fx:id="editBtn" onAction="#handleUpdate" styleClass="outline-button" text="Изменить"/>
                    <Button fx:id="deleteBtn" onAction="#handleDelete" styleClass="outline-button" text="Удалить"/>
                    <Button fx:id="exportBtn" onAction="#handleExport" styleClass="outline-button" text="Экспорт CSV"/>
                </HBox>

                <VBox styleClass="data-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="18" left="18" right="18" top="18"/>
                    </padding>

                    <TableView fx:id="mainTable" VBox.vgrow="ALWAYS"/>

                    <ScrollPane fx:id="reportScrollPane"
                                fitToWidth="true"
                                managed="false"
                                styleClass="report-scroll"
                                visible="false"
                                VBox.vgrow="ALWAYS">

                        <VBox fx:id="reportBox" spacing="30" styleClass="report-container"/>
                    </ScrollPane>
                </VBox>
            </VBox>

        </StackPane>
    </center>

    <bottom>
        <HBox fx:id="brandStrip" alignment="CENTER_LEFT" spacing="28" styleClass="brand-strip">
            <padding>
                <Insets bottom="0" left="34" right="34" top="0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="25" fitWidth="25" preserveRatio="true">
                    <image>
                        <Image url="@icons/instagram.png"/>
                    </image>
                </ImageView>
                <Label styleClass="footer-link" text=".@hospital_lux_md"/>
            </HBox>

            <Label styleClass="footer-dot" text="•"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="25" fitWidth="25" preserveRatio="true">
                    <image>
                        <Image url="@icons/telegram.png"/>
                    </image>
                </ImageView>
                <Label styleClass="footer-link" text=".@hospital_support_md"/>
            </HBox>

            <Label styleClass="footer-dot" text="•"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitHeight="25" fitWidth="25" preserveRatio="true">
                    <image>
                        <Image url="@icons/phone.png"/>
                    </image>
                </ImageView>
                <Label styleClass="footer-link" text="+373 69 123 456"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label styleClass="footer-copyright" text="HospitalLux © 2026"/>
        </HBox>
    </bottom>

</BorderPane>